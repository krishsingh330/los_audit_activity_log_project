# Database Connection String
# Format: postgresql://username:password@hostname:port/database_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/loan_audit_db

# Debug Mode (True/False)
DEBUG=True

# Encryption Key for PII (Audit Logs)
# Critical: If lost, encrypted logs cannot be decrypted.
# You can generate one using: 
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENUM_ENCRYPTION_KEY=change_this_to_a_secure_random_key_in_production
